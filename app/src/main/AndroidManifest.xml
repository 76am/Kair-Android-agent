<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 共享存储：targetSdk 28 走 legacy 路径（运行时弹窗授权即可）；Android 11+ 用「所有文件访问」。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- 后台常驻：前台服务 + 常驻通知，把进程提升为前台优先级；唤醒锁保证熄屏后任务继续跑。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 申请加入系统省电白名单（侧载应用可用；Play 上架受限）。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 后台悬浮浏览器：App 退到后台时用 TYPE_APPLICATION_OVERLAY 承载同一个 WebView，
         屏幕亮着就能继续截 WebGL 画面。侧载不受影响；Play 上架需说明是核心功能。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- U90 · 进程保活：写 global 设置关幻影进程查杀。development 级权限，安装时不授予，
         经「进程保活」面板引导无线调试 adb 一次性 pm grant；代码硬限只写 settings_enable_monitor_phantom_procs。 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:name=".app.KairApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kair"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Kair"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 崩溃界面：跑在独立的 :crash 进程，主进程崩溃后由其展示错误与导出日志。 -->
        <activity
            android:name=".crash.CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Kair" />

        <!-- 后台常驻前台服务：通知栏常驻一条 Kair 通知，降低进程被回收的概率。 -->
        <service
            android:name=".app.KairForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>